{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "declarations.d.ts",
    "router.d.ts",
    "route-map.d.ts",
    "src/**/*"
  ],
  "exclude": ["tests/**/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./cache/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["unplugin-fonts/client", "@intlify/unplugin-vue-i18n/messages"],
    "noUncheckedIndexedAccess": true
  }
}
