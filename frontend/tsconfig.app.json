{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "vite-env.d.ts",
    "declarations.d.ts",
    "router.d.ts",
    "route-map.d.ts",
    "src/**/*.ts",
    "src/**/*.vue"
  ],
  "exclude": ["tests/**/*"],
  "compilerOptions": {
    /* Build */
    "types": [
      "vite/client",
      "unplugin-fonts/client",
      "@intlify/unplugin-vue-i18n/messages"
    ],
    "lib": ["WebWorker"], // see https://vite.dev/guide/env-and-mode#intellisense-for-typescript
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowArbitraryExtensions": true,
    "composite": true,
    "tsBuildInfoFile": "./cache/tsconfig.app.tsbuildinfo",

    /* Lint */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  }
}
